{
  "name": "contacts",
  "display_name": "Contacts",
  "description": "goerp codegen's example module",
  "version": "0.1.0",
  "type": "domain",
  "abi_version": "1",
  "engine": ">=0.1.0",
  "depends_on": [],
  "capabilities": ["db.read", "db.write"],
  "permissions": [
    {"name": "contacts:contact:read", "label": "Read contacts"},
    {"name": "contacts:contact:write", "label": "Write contacts"}
  ],
  "error_codes": ["contacts.contact.duplicate_email"],
  "schema": {"owned_models": []},
  "views": [
    {
      "name": "contacts_list",
      "type": "list",
      "resource": "contacts.contact",
      "label": "Contacts",
      "actions": [
        {"label": "New Contact", "type": "create", "view": "contacts_form"}
      ],
      "bulk_actions": [
        {"label": "Merge", "type": "route", "route": "contacts.merge"}
      ]
    },
    {
      "name": "contacts_form",
      "type": "form",
      "resource": "contacts.contact",
      "label": "Contact",
      "header_actions": [
        {"label": "Archive", "type": "route", "route": "contacts.archive"},
        {"label": "Convert", "type": "route", "route": "contacts.convert"}
      ]
    },
    {
      "name": "companies_form",
      "type": "form",
      "resource": "contacts.company",
      "label": "Company",
      "header_actions": [
        {"label": "Create", "type": "route", "route": "contacts.create"}
      ]
    }
  ]
}
