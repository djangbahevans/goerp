{
  "abi_version": "1",
  "capabilities": [
    "db.read",
    "db.write",
    "event.emit",
    "authz.check"
  ],
  "checksum": "sha256:empty",
  "depends_on": [],
  "description": "Directory of people and organizations",
  "display_name": "Contacts",
  "emits": [
    {
      "name": "contacts.contact.created",
      "version": 1,
      "description": "Emitted when a contact is created",
      "payload_schema": {
        "contact_id": "string",
        "display_name": "string",
        "email": "string?",
        "phone": "string?",
        "type": "string"
      }
    },
    {
      "name": "contacts.contact.deleted",
      "version": 1,
      "description": "Emitted when a contact is archived",
      "payload_schema": {
        "contact_id": "string",
        "display_name": "string"
      }
    },
    {
      "name": "contacts.contact.updated",
      "version": 1,
      "description": "Emitted when a contact is updated, with the fields that changed",
      "payload_schema": {
        "changed_fields": "[]string",
        "contact_id": "string",
        "display_name": "string",
        "email": "string?",
        "phone": "string?"
      }
    }
  ],
  "engine": ">=0.1.0",
  "name": "contacts",
  "navigation": [
    {
      "label": "Contacts",
      "icon": "users",
      "order": 10,
      "children": [
        {
          "label": "All Contacts",
          "view": "contacts_list",
          "route": "/contacts",
          "permission": "contacts:contact:read"
        },
        {
          "label": "People",
          "view": "contacts_list",
          "route": "/contacts",
          "default_filters": {
            "type": "person",
            "is_active": true
          },
          "permission": "contacts:contact:read"
        },
        {
          "label": "Organizations",
          "view": "contacts_list",
          "route": "/contacts",
          "default_filters": {
            "type": "organization",
            "is_active": true
          },
          "permission": "contacts:contact:read"
        },
        {
          "label": "Tags",
          "view": "tags_list",
          "route": "/tags",
          "permission": "contacts:config:write"
        },
        {
          "label": "Identifier Types",
          "view": "identifier_types_list",
          "route": "/identifier-types",
          "permission": "contacts:config:write"
        }
      ]
    }
  ],
  "permissions": [
    {
      "name": "contacts:config:write",
      "description": "Manage tags, relationship types and identifier types",
      "default_roles": [
        "admin"
      ]
    },
    {
      "name": "contacts:contact:delete",
      "description": "Archive contacts",
      "default_roles": [
        "admin"
      ]
    },
    {
      "name": "contacts:contact:read",
      "description": "View contacts",
      "default_roles": [
        "user",
        "admin"
      ]
    },
    {
      "name": "contacts:contact:write",
      "description": "Create and edit contacts",
      "default_roles": [
        "user",
        "admin"
      ]
    },
    {
      "name": "contacts:identifier:read",
      "description": "View identifiers of non-sensitive types",
      "default_roles": [
        "user",
        "admin"
      ]
    },
    {
      "name": "contacts:identifier:write",
      "description": "Create and edit identifiers of non-sensitive types",
      "default_roles": [
        "user",
        "admin"
      ]
    },
    {
      "name": "contacts:personal:read",
      "description": "View dates of birth, gender and sensitive identifiers",
      "default_roles": [
        "admin"
      ]
    },
    {
      "name": "contacts:personal:write",
      "description": "Edit dates of birth, gender and sensitive identifiers",
      "default_roles": [
        "admin"
      ]
    }
  ],
  "schema": {
    "owned_models": [
      "contacts.address",
      "contacts.channel",
      "contacts.contact",
      "contacts.identifier",
      "contacts.identifier_type",
      "contacts.tag"
    ]
  },
  "type": "domain",
  "version": "0.1.0",
  "views": [
    {
      "name": "contacts_list",
      "type": "list",
      "resource": "contacts.contact",
      "label": "Contacts",
      "label_field": "display_name",
      "columns": [
        {
          "field": "display_name",
          "label": "Name",
          "primary": true,
          "sortable": true
        },
        {
          "field": "sort_name",
          "label": "Name (family first)",
          "sortable": true,
          "hidden": true
        },
        {
          "field": "type",
          "label": "Type",
          "type": "badge"
        },
        {
          "field": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "field": "email",
          "label": "Email",
          "type": "email"
        },
        {
          "field": "is_active",
          "label": "Active",
          "type": "boolean"
        },
        {
          "field": "city",
          "label": "City",
          "sortable": true,
          "card": false
        }
      ],
      "filters": [
        {
          "field": "type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "person",
              "label": "Person"
            },
            {
              "value": "organization",
              "label": "Organization"
            }
          ]
        },
        {
          "field": "tag_ids",
          "label": "Tags",
          "type": "relation",
          "resource": "contacts.tag",
          "multiple": true
        },
        {
          "field": "is_active",
          "label": "Active",
          "type": "boolean",
          "default": true
        }
      ],
      "row_click": "contacts_form",
      "actions": [
        {
          "label": "New Contact",
          "type": "create",
          "view": "contacts_form"
        }
      ],
      "default_sort": "sort_name"
    },
    {
      "name": "contacts_form",
      "type": "form",
      "resource": "contacts.contact",
      "label": "Contact",
      "sections": [
        {
          "name": "identity",
          "label": "Identity",
          "columns": 2,
          "fields": [
            {
              "field": "type",
              "label": "Type",
              "type": "select",
              "required": true,
              "span": 2,
              "options": [
                {
                  "value": "person",
                  "label": "Person"
                },
                {
                  "value": "organization",
                  "label": "Organization"
                }
              ]
            },
            {
              "field": "title",
              "label": "Title",
              "condition": "record.type = 'person'"
            },
            {
              "field": "preferred_name",
              "label": "Preferred name",
              "condition": "record.type = 'person'"
            },
            {
              "field": "given_name",
              "label": "Given name",
              "condition": "record.type = 'person'"
            },
            {
              "field": "family_name",
              "label": "Family name",
              "condition": "record.type = 'person'"
            },
            {
              "field": "other_names",
              "label": "Other names",
              "condition": "record.type = 'person'"
            },
            {
              "field": "legal_name",
              "label": "Legal name",
              "required": true,
              "condition": "record.type = 'organization'"
            },
            {
              "field": "trading_name",
              "label": "Trading name",
              "condition": "record.type = 'organization'"
            },
            {
              "field": "avatar_file_id",
              "label": "Avatar",
              "type": "avatar_upload"
            },
            {
              "field": "is_active",
              "label": "Active",
              "type": "boolean"
            },
            {
              "field": "tag_ids",
              "label": "Tags",
              "type": "tags",
              "resource": "contacts.tag",
              "resource_label_field": "name",
              "span": 2
            }
          ]
        },
        {
          "name": "personal",
          "label": "Personal details",
          "columns": 2,
          "condition": "record.type = 'person' AND user_has_permission('contacts:personal:read')",
          "fields": [
            {
              "field": "date_of_birth",
              "label": "Date of birth",
              "type": "date",
              "readonly_condition": "NOT user_has_permission('contacts:personal:write')"
            },
            {
              "field": "gender",
              "label": "Gender",
              "readonly_condition": "NOT user_has_permission('contacts:personal:write')"
            }
          ]
        },
        {
          "name": "preferences",
          "label": "Preferences",
          "columns": 2,
          "collapsible": true,
          "fields": [
            {
              "field": "preferred_channel",
              "label": "Preferred channel",
              "type": "select",
              "options": [
                {
                  "value": "phone",
                  "label": "Phone"
                },
                {
                  "value": "sms",
                  "label": "SMS"
                },
                {
                  "value": "whatsapp",
                  "label": "WhatsApp"
                },
                {
                  "value": "email",
                  "label": "Email"
                }
              ]
            },
            {
              "field": "language",
              "label": "Language",
              "type": "language_select"
            },
            {
              "field": "website",
              "label": "Website",
              "type": "url",
              "span": 2
            }
          ]
        }
      ],
      "tabs": [
        {
          "label": "Phones & emails",
          "icon": "phone",
          "type": "fields",
          "sections": [
            {
              "name": "channels",
              "label": "Phones & emails",
              "type": "sub_list",
              "field": "channel_ids",
              "inline_edit": true,
              "add_label": "Add channel",
              "columns": [
                {
                  "field": "kind",
                  "label": "Kind",
                  "type": "badge",
                  "badge_config": {
                    "phone": {
                      "label": "Phone"
                    },
                    "email": {
                      "label": "Email"
                    }
                  },
                  "width": 120
                },
                {
                  "field": "value",
                  "label": "Value",
                  "input_type_field": "kind",
                  "width": 300
                },
                {
                  "field": "label",
                  "label": "Label",
                  "type": "badge",
                  "badge_config": {
                    "mobile": {
                      "label": "Mobile"
                    },
                    "home": {
                      "label": "Home"
                    },
                    "work": {
                      "label": "Work"
                    },
                    "other": {
                      "label": "Other"
                    }
                  },
                  "width": 120
                },
                {
                  "field": "is_primary",
                  "label": "Primary",
                  "type": "boolean",
                  "width": 95
                },
                {
                  "field": "whatsapp",
                  "label": "WhatsApp",
                  "type": "boolean",
                  "width": 110
                },
                {
                  "field": "marketing_consent",
                  "label": "Marketing consent",
                  "type": "badge",
                  "badge_config": {
                    "unknown": {
                      "label": "Unknown"
                    },
                    "granted": {
                      "label": "Granted"
                    },
                    "withdrawn": {
                      "label": "Withdrawn"
                    }
                  },
                  "width": 170
                },
                {
                  "field": "consent_updated_at",
                  "label": "Consent updated",
                  "type": "datetime",
                  "width": 190
                },
                {
                  "field": "consent_source",
                  "label": "Consent source",
                  "width": 180
                }
              ]
            }
          ]
        },
        {
          "label": "Addresses",
          "icon": "map-pin",
          "type": "view",
          "view": "contacts.addresses_for_contact",
          "filter": {
            "contact_id": "record.id"
          },
          "show_create_action": true
        },
        {
          "label": "Identifiers",
          "icon": "id-card",
          "type": "fields",
          "permission": "contacts:identifier:read",
          "sections": [
            {
              "name": "identifiers",
              "label": "Identifiers",
              "type": "sub_list",
              "field": "identifier_ids",
              "inline_edit": true,
              "add_label": "Add identifier",
              "columns": [
                {
                  "field": "type_id",
                  "label": "Type",
                  "type": "relation",
                  "resource": "contacts.identifier_type",
                  "resource_label_field": "label"
                },
                {
                  "field": "value",
                  "label": "Value"
                },
                {
                  "field": "expires_on",
                  "label": "Expires",
                  "type": "date"
                }
              ]
            }
          ]
        },
        {
          "label": "Notes",
          "icon": "file-text",
          "type": "fields",
          "sections": [
            {
              "columns": 1,
              "fields": [
                {
                  "field": "notes",
                  "label": "Notes",
                  "type": "textarea"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "tags_list",
      "type": "list",
      "resource": "contacts.tag",
      "label": "Tags",
      "label_field": "name",
      "columns": [
        {
          "field": "name",
          "label": "Name",
          "primary": true,
          "sortable": true
        },
        {
          "field": "color",
          "label": "Color",
          "type": "color"
        }
      ],
      "row_click": "tags_form",
      "actions": [
        {
          "label": "New Tag",
          "type": "create",
          "view": "tags_form"
        }
      ],
      "default_sort": "name"
    },
    {
      "name": "tags_form",
      "type": "form",
      "resource": "contacts.tag",
      "label": "Tag",
      "sections": [
        {
          "name": "details",
          "label": "Details",
          "columns": 2,
          "fields": [
            {
              "field": "name",
              "label": "Name",
              "required": true
            },
            {
              "field": "color",
              "label": "Color",
              "type": "color_picker"
            }
          ]
        }
      ]
    },
    {
      "name": "addresses_for_contact",
      "type": "list",
      "resource": "contacts.address",
      "label": "Addresses",
      "label_field": "label",
      "columns": [
        {
          "field": "type",
          "label": "Type",
          "primary": true
        },
        {
          "field": "label",
          "label": "Label"
        },
        {
          "field": "street",
          "label": "Street"
        },
        {
          "field": "city",
          "label": "City"
        },
        {
          "field": "postal_code",
          "label": "Postal code"
        },
        {
          "field": "country_code",
          "label": "Country code"
        },
        {
          "field": "is_primary",
          "label": "Primary",
          "type": "boolean"
        }
      ],
      "row_click": "address_form",
      "actions": [
        {
          "label": "New Address",
          "type": "create",
          "view": "address_form"
        }
      ],
      "default_sort": "created_at"
    },
    {
      "name": "address_form",
      "type": "form",
      "resource": "contacts.address",
      "label": "Address",
      "sections": [
        {
          "name": "address",
          "label": "Address",
          "columns": 2,
          "fields": [
            {
              "field": "contact_id",
              "label": "Contact",
              "type": "relation",
              "resource": "contacts.contact",
              "required": true
            },
            {
              "field": "type",
              "label": "Type",
              "type": "select",
              "options": [
                {
                  "value": "home",
                  "label": "Home"
                },
                {
                  "value": "postal",
                  "label": "Postal"
                },
                {
                  "value": "billing",
                  "label": "Billing"
                },
                {
                  "value": "delivery",
                  "label": "Delivery"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            },
            {
              "field": "label",
              "label": "Label"
            },
            {
              "field": "street",
              "label": "Street"
            },
            {
              "field": "street2",
              "label": "Street 2"
            },
            {
              "field": "city",
              "label": "City"
            },
            {
              "field": "postal_code",
              "label": "Postal code"
            },
            {
              "field": "country_code",
              "label": "Country code"
            },
            {
              "field": "is_primary",
              "label": "Primary",
              "type": "boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "identifier_types_list",
      "type": "list",
      "resource": "contacts.identifier_type",
      "label": "Identifier Types",
      "label_field": "label",
      "columns": [
        {
          "field": "label",
          "label": "Label",
          "primary": true
        },
        {
          "field": "code",
          "label": "Code"
        },
        {
          "field": "applies_to",
          "label": "Applies to"
        },
        {
          "field": "is_unique",
          "label": "Unique",
          "type": "boolean"
        },
        {
          "field": "is_tax",
          "label": "Tax",
          "type": "boolean"
        },
        {
          "field": "is_sensitive",
          "label": "Sensitive",
          "type": "boolean"
        },
        {
          "field": "is_active",
          "label": "Active",
          "type": "boolean"
        }
      ],
      "row_click": "identifier_type_form",
      "actions": [
        {
          "label": "New Identifier Type",
          "type": "create",
          "view": "identifier_type_form"
        }
      ],
      "default_sort": "label"
    },
    {
      "name": "identifier_type_form",
      "type": "form",
      "resource": "contacts.identifier_type",
      "label": "Identifier Type",
      "sections": [
        {
          "name": "identifier_type",
          "label": "Identifier Type",
          "columns": 2,
          "fields": [
            {
              "field": "code",
              "label": "Code",
              "required": true
            },
            {
              "field": "label",
              "label": "Label",
              "required": true
            },
            {
              "field": "applies_to",
              "label": "Applies to",
              "type": "select",
              "options": [
                {
                  "value": "any",
                  "label": "Any contact"
                },
                {
                  "value": "person",
                  "label": "Person"
                },
                {
                  "value": "organization",
                  "label": "Organization"
                }
              ]
            },
            {
              "field": "country_code",
              "label": "Country code"
            },
            {
              "field": "pattern",
              "label": "Pattern",
              "help_text": "RE2 pattern matched against the complete value."
            },
            {
              "field": "uppercase",
              "label": "Upper-case values",
              "type": "boolean"
            },
            {
              "field": "is_unique",
              "label": "Unique",
              "type": "boolean"
            },
            {
              "field": "is_tax",
              "label": "Tax identifier",
              "type": "boolean"
            },
            {
              "field": "is_sensitive",
              "label": "Sensitive",
              "type": "boolean"
            },
            {
              "field": "is_active",
              "label": "Active",
              "type": "boolean"
            },
            {
              "field": "owner_module",
              "label": "Owner module",
              "readonly": true
            }
          ]
        }
      ]
    }
  ],
  "error_codes": [
    "contacts.channel.not_found",
    "contacts.channel.validation_failed",
    "contacts.channel.forbidden",
    "contacts.channel.conflict",
    "contacts.channel.failed",
    "contacts.address.not_found",
    "contacts.address.validation_failed",
    "contacts.address.forbidden",
    "contacts.address.conflict",
    "contacts.address.failed",
    "contacts.identifier.not_found",
    "contacts.identifier.validation_failed",
    "contacts.identifier.forbidden",
    "contacts.identifier.conflict",
    "contacts.identifier.failed"
  ],
  "policies": [
    {
      "name": "contacts:identifier:sensitive",
      "applies_to": "contacts:identifier:read",
      "condition": "user_has_permission('contacts:identifier:read') AND (record.is_sensitive = false OR user_has_permission('contacts:personal:read'))"
    },
    {
      "name": "contacts:identifier:visible_write",
      "applies_to": "contacts:identifier:write",
      "condition": "user_has_permission('contacts:identifier:read') AND (record.is_sensitive = false OR user_has_permission('contacts:personal:read'))"
    }
  ]
}
