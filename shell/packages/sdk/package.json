{
  "name": "@goerp/sdk",
  "version": "0.0.0",
  "description": "GoERP frontend SDK — module registration, generic hooks, and the component library shared by module frontend/ projects.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js",
    "./auth": "./dist/auth/index.js",
    "./components": "./dist/components/index.js",
    "./i18n": "./dist/i18n/index.js",
    "./nav": "./dist/nav/index.js",
    "./realtime": "./dist/realtime/index.js",
    "./form": "./dist/form/index.js",
    "./notifications": "./dist/notifications/index.js",
    "./error": "./dist/error/index.js",
    "./schema": "./dist/schema/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
