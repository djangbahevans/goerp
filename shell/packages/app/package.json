{
  "name": "@goerp/shell-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-route-tree": "tsr generate",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "build:types": "npm run generate-route-tree && tsc -p tsconfig.json",
    "typecheck": "npm run generate-route-tree && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest-passkeys": "npm run build -w @goerp/sdk",
    "test-passkeys": "node scripts/test-passkeys.mjs",
    "pretest-module-runtime": "npm run build -w @goerp/sdk",
    "test-module-runtime": "node scripts/test-module-runtime.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@goerp/sdk": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.41",
    "flag-icons": "^7.5.0",
    "maplibre-gl": "^6.10.0",
    "motion": "^13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valibot": "^1.5.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.3"
  }
