# Copy to .env and fill in for a real deployment. Every value here is a
# Vite build-time env var — baked into the static bundle at build time, not
# read at runtime, and identical across every tenant on this deployment.

# Public URL of a self-hosted PMTiles basemap archive (see
# scripts/generate-ghana-pmtiles.sh at the repo root, and
# docs/components/location-field.md in nexus-docs). Unset renders
# LocationField's plain-background fallback — marker placement, coordinate
# entry, and accessibility are unaffected either way.
VITE_MAP_TILE_URL=

# Where the tenant-suspended page's "Contact support" button points: an
# https:// support page or a mailto: address (docs/shell-ux.md §6.6 in
# nexus-docs). Unset hides the button, leaving only "Sign in with a
# different account".
VITE_SUPPORT_URL=

# The help panel's links (docs/shell-ux.md §7.4 in nexus-docs): the
# documentation site, the API reference, the status page, and "What's new"
# (the changelog or release notes). Each unset link is hidden.
VITE_DOCS_URL=
VITE_API_REFERENCE_URL=
VITE_STATUS_PAGE_URL=
VITE_CHANGELOG_URL=
