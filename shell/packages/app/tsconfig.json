{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // No real .js output — this app is bundled by Vite, not tsc.
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx"]
}
